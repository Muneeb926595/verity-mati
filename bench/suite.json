{
  "_doc": "Known-answer benchmark. Expectations were written by hand from the source (and, for scenarios, from the independent reference harness bench/gold/reference_harness.c). Paths are relative to each project root.",
  "projects": {"c": "samples/navgps-c", "cs": "samples/navgps-cs"},
  "cases": [
    {"id": "c-explain-process", "project": "c", "category": "symbol", "q": "What does ProcessGpsData() do?",
     "intent": "explain", "must_mention": ["gps_validate_fix", "nav_handle_invalid_fix", "CalculateHeading", "currentHeading", "NAV_MODE_TRACKING"],
     "must_cite": ["nav/navigation.c:45", "nav/navigation.c:49", "nav/navigation.c:59"]},
    {"id": "c-purpose-heading", "project": "c", "category": "symbol", "q": "What is the purpose of currentHeading?",
     "must_mention": ["ProcessGpsData", "CalculateHeading", "NavigationTick", "motor_set_steering"],
     "must_cite": ["nav/navigation.c:7", "nav/navigation.c:59", "nav/navigation.c:81"]},
    {"id": "c-flow-gps", "project": "c", "category": "dataflow", "q": "Explain how GPS data travels through this application.",
     "intent": "flow", "flow_contains": ["USART2_IRQHandler", "rb_push", "rb_pop", "gps_receiver_process_line", "nmea_split", "handle_rmc", "ProcessGpsData", "CalculateHeading", "NavigationTick", "VehicleController_SetDirection", "motor_set_steering"],
     "must_cite": ["drivers/uart_isr.c:11"]},
    {"id": "c-flow-show", "project": "c", "category": "dataflow", "q": "Show me the GPS data flow",
     "intent": "flow", "flow_contains": ["USART2_IRQHandler", "gps_receiver_process_line", "handle_rmc", "ProcessGpsData", "motor_set_steering"]},
    {"id": "c-origin-lat", "project": "c", "category": "dataflow", "q": "Where does latitude come from?",
     "intent": "origin", "flow_contains": ["USART2_IRQHandler", "nmea_split", "handle_rmc", "nmea_parse_coord", "ProcessGpsData"],
     "must_mention": ["nmea_parse_coord"], "must_cite": ["gps/gps_receiver.c:67", "nav/navigation.c:54"]},
    {"id": "c-receives", "project": "c", "category": "symbol", "q": "Which function receives the GPS packet?",
     "intent": "receives", "must_mention": ["USART2_IRQHandler", "gps_receiver_process_line", "ProcessGpsData"]},
    {"id": "c-where-heading", "project": "c", "category": "symbol", "q": "Where is heading calculated?",
     "intent": "where_computed", "must_mention": ["CalculateHeading", "currentHeading"], "must_cite": ["nav/navigation.c:33"]},
    {"id": "c-invalid", "project": "c", "category": "scenario", "q": "What happens if GPS data is invalid?",
     "intent": "failure_invalid", "must_mention": ["gps_validate_fix", "nav_handle_invalid_fix", "NAV_MODE_DEGRADED", "MAX_INVALID_FIXES"],
     "run_state_any": {"g_nav.mode": "2", "g_nav.consecutive_invalid": "5"}, "hw_calls_absent": ["motor_set_steering"]},
    {"id": "c-missing", "project": "c", "category": "scenario", "q": "What happens if GPS becomes unavailable?",
     "intent": "failure_missing", "must_mention": ["GPS_TIMEOUT_MS", "NAV_MODE_HOLD", "VehicleController_Hold", "ENABLE_DEAD_RECKONING"],
     "run_state_any": {"g_nav.mode": "3"}, "hw_calls": ["motor_set_steering(0)", "led_set_status(0)"]},
    {"id": "c-after-process", "project": "c", "category": "callpath", "q": "Which functions are called after ProcessGpsData?",
     "intent": "downstream", "must_mention": ["gps_validate_fix", "nav_handle_invalid_fix", "CalculateHeading", "NavigationTick"],
     "must_not_mention": ["USART2_IRQHandler", "rb_push"]},
    {"id": "c-influence", "project": "c", "category": "dataflow", "q": "Which variables affect the final heading?",
     "intent": "influence", "must_mention": ["heading_deg", "speed_knots", "currentHeading", "HEADING_FILTER_ALPHA", "MIN_SPEED_FOR_HEADING", "gps_validate_fix"]},
    {"id": "c-scenario-270", "project": "c", "category": "scenario", "q": "GPS heading = 270, speed = 80, valid = true. Which branch executes?",
     "intent": "scenario", "run_state": {"currentHeading": "337.5000", "g_nav.mode": "1"}, "hw_calls": ["motor_set_steering(50)"],
     "trace_contains": ["ProcessGpsData", "gps_validate_fix", "CalculateHeading", "NavigationTick", "VehicleController_SetDirection"],
     "branches": {"nav/navigation.c:49": false, "nav/navigation.c:37": false, "nav/navigation.c:68": false}},
    {"id": "c-scenario-sends", "project": "c", "category": "scenario", "q": "What happens when GPS sends heading 270?",
     "intent": "scenario", "run_state": {"currentHeading": "337.5000"}},
    {"id": "c-scenario-slow", "project": "c", "category": "scenario", "q": "What happens if GPS sends heading 270 with speed 1 and valid true?",
     "intent": "scenario", "run_state_absent": ["currentHeading"], "branches": {"nav/navigation.c:37": true}},
    {"id": "c-impact-calc", "project": "c", "category": "callpath", "q": "If I change CalculateHeading(), what else could be affected?",
     "intent": "impact", "must_mention": ["ProcessGpsData", "currentHeading", "NavigationTick", "VehicleController_SetDirection", "motor_set_steering"]},
    {"id": "c-callers-calc", "project": "c", "category": "callpath", "q": "Who calls CalculateHeading?",
     "intent": "callers", "must_mention": ["ProcessGpsData"], "must_not_mention": ["NavigationTick"], "must_cite": ["nav/navigation.c:59"]},
    {"id": "c-callers-process", "project": "c", "category": "callpath", "q": "Who calls ProcessGpsData?",
     "intent": "callers", "must_mention": ["handle_rmc", "g_fix_callback"], "must_cite": ["gps/gps_receiver.c:76", "app/main.c:16"]},
    {"id": "c-callers-rmc", "project": "c", "category": "callpath", "q": "Who calls handle_rmc?",
     "intent": "callers", "must_mention": ["gps_receiver_process_line"], "must_cite": ["gps/gps_receiver.c:97"]},
    {"id": "c-callers-motor", "project": "c", "category": "callpath", "q": "Who calls motor_set_steering?",
     "intent": "callers", "must_mention": ["VehicleController_SetDirection", "VehicleController_Hold"]},
    {"id": "c-explain-setdir", "project": "c", "category": "symbol", "q": "What does VehicleController_SetDirection do?",
     "intent": "explain", "must_mention": ["wrap180", "clamp", "motor_set_steering"]},
    {"id": "c-macro-timeout", "project": "c", "category": "symbol", "q": "What is GPS_TIMEOUT_MS?",
     "must_mention": ["2000"], "must_cite": ["include/nav_config.h:6"]},
    {"id": "c-checksum", "project": "c", "category": "scenario", "q": "What happens if the NMEA checksum is wrong?",
     "must_mention": ["nmea_checksum_ok", "checksum_errors"]},
    {"id": "c-trap-nonexistent", "project": "c", "category": "hallucination", "q": "What does ParseGpsFrame() do?",
     "must_not_claim_defined": ["ParseGpsFrame"]},
    {"id": "c-trap-nonexistent-var", "project": "c", "category": "hallucination", "q": "Who writes the variable gpsAltitude?",
     "must_not_claim_defined": ["gpsAltitude"]},
    {"id": "c-dead-reckoning", "project": "c", "category": "symbol", "q": "What changes when ENABLE_DEAD_RECKONING is defined?",
     "must_mention": ["NAV_MODE_DEAD_RECKONING"]},
    {"id": "cs-callers-process", "project": "cs", "category": "callpath", "q": "Who calls ProcessGpsData?",
     "intent": "callers", "must_mention": ["OnFix", "RunSelfTest"], "must_cite": ["src/Services/GpsService.cs:34", "src/Program.cs:69"]},
    {"id": "cs-implements", "project": "cs", "category": "symbol", "q": "Which classes implement IHeadingFilter?",
     "must_mention": ["ComplementaryHeadingFilter", "KalmanHeadingFilter"]},
    {"id": "cs-writers-heading", "project": "cs", "category": "symbol", "q": "Where is CurrentHeading written?",
     "must_cite": ["src/Navigation/NavigationController.cs:67", "src/Navigation/NavigationController.cs:80"]},
    {"id": "cs-explain-process", "project": "cs", "category": "symbol", "q": "What does ProcessGpsData do?",
     "must_mention": ["Update", "CurrentHeading"]},
    {"id": "cs-event-chain", "project": "cs", "category": "callpath", "q": "Who calls GpsService.OnFix?",
     "must_mention": ["OnFixReceived", "FixReceived"]},
    {"id": "cs-impact-update", "project": "cs", "category": "callpath", "q": "What could be affected if I change NavigationController.ProcessGpsData?",
     "must_mention": ["OnFix", "CurrentHeading"]}
  ]
}
