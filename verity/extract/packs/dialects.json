 "_entry_patterns": {
  "_doc": "source patterns that mark interrupt handlers (checked in every C file; the preprocessor removes the keywords)",
  "patterns": [
   [
    "\\binterrupt\\s+void\\s+([A-Za-z_]\\w*)\\s*\\(",
    "interrupt handler (TI 'interrupt' keyword)"
   ],
   [
    "\\b__interrupt\\s+void\\s+([A-Za-z_]\\w*)\\s*\\(",
    "interrupt handler (__interrupt)"
   ],
   [
    "#\\s*pragma\\s+INTERRUPT\\s*\\(\\s*([A-Za-z_]\\w*)",
    "interrupt handler (#pragma INTERRUPT)"
   ],
   [
    "#\\s*pragma\\s+vector\\s*=\\s*\\w+\\s*\\n\\s*__interrupt\\s+void\\s+([A-Za-z_]\\w*)",
    "interrupt handler (#pragma vector)"
   ],
   [
    "\\bISR\\s*\\(\\s*([A-Za-z_]\\w*)\\s*\\)",
    "interrupt handler (ISR() macro)"
   ],
   [
    "__attribute__\\s*\\(\\(\\s*(?:interrupt|isr|signal)[^)]*\\)\\)\\s*void\\s+([A-Za-z_]\\w*)",
    "interrupt handler (attribute)"
   ],
   [
    "\\b__irq\\s+void\\s+([A-Za-z_]\\w*)\\s*\\(",
    "interrupt handler (__irq)"
   ]
  ]
 }
